# VENKATARAMANA ENTERPRISES Configuration
# Cloud Turso Database (optional - if omitted, local SQLite data/local.db is used automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Owner Security PIN (Default setup placeholder: 1234. Change before production!)
OWNER_PIN=1234

# GST / Tax percentage (Leave empty or set percentage e.g. 18. Do NOT assume unless specified by owner)
GST_RATE=

# Server Port
PORT=3000
